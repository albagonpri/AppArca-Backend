generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis]
}

enum EstadoReserva {
  PENDIENTE
  CONFIRMADA
  CANCELADA
  COMPLETADA
}

enum EtiquetaAmbiental {
  CERO
  ECO
  C
  B
  SIN_DISTINTIVO
}

enum TipoPropulsion {
  GASOLINA
  DIESEL
  HIBRIDO_NO_ENCHUFABLE
  HIBRIDO_ENCHUFABLE
  ELECTRICO_PURO
  OTRO
}

enum DificultadEntrada {
  RESALTO
  ENTRADA_ESTRECHA
  RAMPA_PRONUNCIADA
  PENDIENTE_PRONUNCIADA
  GIRO_CERRADO
  ALTURA_LIMITADA
  ANCHURA_LIMITADA
  OBSTACULOS
  MANIOBRA_REDUCIDA
  SUELO_IRREGULAR
  VEHICULOS_BAJOS
  OTRA
}

model Usuario {
  id                 Int       @id @default(autoincrement())
  nombre             String
  correo             String    @unique
  contrasenaHash     String?
  esAdmin            Boolean   @default(false)
  fechaCreacion      DateTime  @default(now())
  fechaActualizacion DateTime  @updatedAt

  plazas             Plaza[]
  reservas           Reserva[]
  vehiculos          Vehiculo[]
  favoritos          Favorito[]

  @@map("usuarios")
}

model Vehiculo {
  id                 Int                @id @default(autoincrement())
  usuarioId          Int
  usuario            Usuario            @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  marca              String?
  modelo             String?
  matricula          String
  etiquetaAmbiental  EtiquetaAmbiental
  anyo               Int?
  version            String?
  tipoPropulsion     TipoPropulsion?
  esEnchufable       Boolean            @default(false)
  longitud           Float?
  anchura            Float?
  altura             Float?
  suspensionBaja     Boolean            @default(false)
  catalogoVehiculoId Int?
  catalogoVehiculo   CatalogoVehiculo?  @relation(fields: [catalogoVehiculoId], references: [id], onDelete: SetNull)
  fechaCreacion      DateTime           @default(now())
  fechaActualizacion DateTime           @updatedAt

  reservas           Reserva[]

  @@map("vehiculos")
}

model CatalogoVehiculo {
  id                  Int                @id @default(autoincrement())
  marca               String
  modelo              String
  generacion          String?
  anyoInicio          Int?
  anyoFin             Int?
  carroceria          String?
  version             String
  tipoPropulsion      TipoPropulsion
  combustibleDetalle  String?
  potenciaCv          Int?
  esEnchufable        Boolean            @default(false)
  etiquetaDgtSugerida EtiquetaAmbiental?
  etiquetaDgtFiable   Boolean            @default(false)
  longitud            Float?
  anchura             Float?
  altura              Float?
  origen              String             @default("gor3a/vehicle-makes-models")
  fechaCreacion       DateTime           @default(now())

  vehiculos           Vehiculo[]

  @@index([marca])
  @@index([modelo])
  @@index([marca, modelo])
  @@map("catalogo_vehiculos")
}

model Plaza {
  tipoDisponibilidad TipoDisponibilidad @default(HABITUAL)
  horario Json?
  id                 Int       @id @default(autoincrement())
  propietarioId      Int
  propietario        Usuario   @relation(fields: [propietarioId], references: [id], onDelete: Cascade)
  titulo             String
  descripcion        String?
  direccion          String
  poblacion          String?
  numeroPlaza        String?
  planta             String?
  indicacionesAcceso String?
  latitud            Float
  longitud           Float
  precioHora         Float
  largo              Float
  ancho              Float
  entradaDificil     Boolean             @default(false)
  descripcionEntrada String?
  dificultadesEntrada DificultadEntrada[] @default([])
  tieneCamaras           Boolean   @default(false)
  estaCubierta           Boolean   @default(false)
  tieneCargadorElectrico Boolean   @default(false)
  disponible             Boolean   @default(true)
  alturaMaxima           Float?
  fechaCreacion      DateTime  @default(now())
  fechaActualizacion DateTime  @updatedAt

  reservas           Reserva[]
  fotos              FotoPlaza[]
  favoritos          Favorito[]

  @@map("plazas")
}

model FotoPlaza {
  id            Int      @id @default(autoincrement())
  plazaId       Int
  plaza         Plaza    @relation(fields: [plazaId], references: [id], onDelete: Cascade)
  url           String
  orden         Int      @default(0)
  fechaCreacion DateTime @default(now())

  @@index([plazaId])
  @@map("fotos_plazas")
}

model Favorito {
  id            Int      @id @default(autoincrement())
  usuarioId     Int
  usuario       Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  plazaId       Int
  plaza         Plaza    @relation(fields: [plazaId], references: [id], onDelete: Cascade)
  fechaCreacion DateTime @default(now())

  @@unique([usuarioId, plazaId])
  @@index([usuarioId])
  @@index([plazaId])
  @@map("favoritos")
}

model Reserva {
  id                 Int           @id @default(autoincrement())
  usuarioId          Int
  usuario            Usuario       @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  plazaId            Int
  plaza              Plaza         @relation(fields: [plazaId], references: [id], onDelete: Cascade)
  vehiculoId         Int?
  vehiculo           Vehiculo?     @relation(fields: [vehiculoId], references: [id], onDelete: SetNull)
  fechaInicio        DateTime
  fechaFin           DateTime
  estado             EstadoReserva @default(PENDIENTE)
  precioTotal        Decimal?      @db.Decimal(10, 2)
  fechaCreacion      DateTime      @default(now())
  fechaActualizacion DateTime      @updatedAt

  @@map("reservas")
}

enum TipoDisponibilidad {
  HABITUAL
  PUNTUAL
}
