generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis]
}

enum EstadoReserva {
  PENDIENTE
  CONFIRMADA
  CANCELADA
  COMPLETADA
}

enum EtiquetaAmbiental {
  CERO
  ECO
  C
  B
  SIN_DISTINTIVO
}

enum DificultadEntrada {
  RESALTO
  ENTRADA_ESTRECHA
  RAMPA_PRONUNCIADA
  PENDIENTE_PRONUNCIADA
  GIRO_CERRADO
  ALTURA_LIMITADA
  ANCHURA_LIMITADA
  OBSTACULOS
  MANIOBRA_REDUCIDA
  SUELO_IRREGULAR
  VEHICULOS_BAJOS
  OTRA
}

model Usuario {
  id                 Int       @id @default(autoincrement())
  nombre             String
  correo             String    @unique
  contrasenaHash     String?
  esAdmin            Boolean   @default(false)
  fechaCreacion      DateTime  @default(now())
  fechaActualizacion DateTime  @updatedAt

  plazas             Plaza[]
  reservas           Reserva[]
  vehiculos          Vehiculo[]

  @@map("usuarios")
}

model Vehiculo {
  id                 Int                @id @default(autoincrement())
  usuarioId          Int
  usuario            Usuario            @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  marca              String?
  modelo             String?
  matricula          String
  etiquetaAmbiental  EtiquetaAmbiental
  longitud           Float?
  anchura            Float?
  altura             Float?
  suspensionBaja     Boolean            @default(false)
  fechaCreacion      DateTime           @default(now())
  fechaActualizacion DateTime           @updatedAt

  @@map("vehiculos")
}

model Plaza {
  id                 Int       @id @default(autoincrement())
  propietarioId      Int
  propietario        Usuario   @relation(fields: [propietarioId], references: [id], onDelete: Cascade)
  titulo             String
  descripcion        String?
  direccion          String
  latitud            Float
  longitud           Float
  precioHora         Float
  largo              Float
  ancho              Float
  entradaDificil     Boolean             @default(false)
  descripcionEntrada String?
  dificultadesEntrada DificultadEntrada[] @default([])
  tieneCamaras       Boolean             @default(false)
  disponible         Boolean   @default(true)
  fechaCreacion      DateTime  @default(now())
  fechaActualizacion DateTime  @updatedAt

  reservas           Reserva[]

  @@map("plazas")
}

model Reserva {
  id                 Int           @id @default(autoincrement())
  usuarioId          Int
  usuario            Usuario       @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  plazaId            Int
  plaza              Plaza         @relation(fields: [plazaId], references: [id], onDelete: Cascade)
  fechaInicio        DateTime
  fechaFin           DateTime
  estado             EstadoReserva @default(PENDIENTE)
  fechaCreacion      DateTime      @default(now())
  fechaActualizacion DateTime      @updatedAt

  @@map("reservas")
}
